{
  "name": "visual-nuget",
  "displayName": "Visual NuGet",
  "description": "A visual NuGet package manager. Search for, install and uninstall NuGet packages.",
  "version": "0.5.1",
  "icon": "images/logo.png",
  "publisher": "fullstackspider",
  "author": {
    "name": "Adrian Pavel"
  },
  "engines": {
    "vscode": "^1.64.0"
  },
  "main": "./dist/src-ext/extension.js",
  "categories": [
    "Other"
  ],
  "keywords": [
    "nuget",
    "dotnet",
    "c#",
    "package",
    "manager"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/adrian-pavel/visual-nuget.git"
  },
  "bugs": {
    "url": "https://github.com/adrian-pavel/visual-nuget/issues"
  },
  "homepage": "https://github.com/adrian-pavel/visual-nuget/blob/master/README.md",
  "license": "SEE LICENSE IN LICENSE",
  "preview": true,
  "activationEvents": [
    "onCommand:visualnuget.managePackages",
    "onCommand:visualnuget.managePackagesPalette",
    "onCommand:visualnuget.manageSolutionPackages",
    "onCommand:visualnuget.manageSolutionPackagesPalette"
  ],
  "contributes": {
    "commands": [
      {
        "command": "visualnuget.managePackages",
        "title": "Visual NuGet: Manage Packages"
      },
      {
        "command": "visualnuget.managePackagesPalette",
        "title": "Visual NuGet: Manage Packages"
      },
      {
        "command": "visualnuget.manageSolutionPackages",
        "title": "Visual NuGet: Manage Solution Packages"
      },
      {
        "command": "visualnuget.manageSolutionPackagesPalette",
        "title": "Visual NuGet: Manage Solution Packages"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "visualnuget.managePackages",
          "when": "false"
        },
        {
          "command": "visualnuget.manageSolutionPackages",
          "when": "false"
        },
        {
          "command": "visualnuget.managePackagesPalette"
        },
        {
          "command": "visualnuget.manageSolutionPackagesPalette"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceExtname == .csproj || resourceExtname == .vbproj || resourceExtname == .fsproj",
          "command": "visualnuget.managePackages",
          "group": "navigation"
        },
        {
          "when": "resourceExtname == .sln || resourceExtname == .slnx",
          "command": "visualnuget.manageSolutionPackages",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Visual NuGet",
      "properties": {
        "VisualNuGet.sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "{\"name\": \"nuget.org\",\"url\": \"https://api.nuget.org/v3/index.json\"}"
          ],
          "uniqueItems": true,
          "markdownDescription": "Each source needs to be it's own item in the list.  eg.: {\"name\": \"MyAwesomeServer\",\"url\": \"https://myPrivateNugetServer.com/v3/index.json\", \"authorizationHeader\": \"Basic VnNzU2Vzc2lvblRva2VuOk15TmV3bHlDcmVhdGVkUEFU\"}"
        }
      }
    }
  },
  "watch": {
    "build": {
      "patterns": [
        "src",
        "src-ext",
        "src-common"
      ],
      "extensions": "ts,html,scss"
    }
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration development && tsc -p tsconfig.ext.json",
    "package": "vsce package",
    "publish": "vsce publish",
    "watch": "npm-watch",
    "package-ext": "webpack --mode production --devtool hidden-source-map",
    "angular-prod": "ng build --configuration production",
    "package-all": "npm run angular-prod && npm run package-ext",
    "vscode:prepublish": "npm run package-all",
    "lint": "ng lint",
    "test": "jest",
    "test-coverage": "jest --coverage",
    "test:extension": "vscode-test",
    "test:watch": "jest --watch"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-browser-dynamic": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "angular-split": "^20.0.0",
    "rxjs": "~7.8.1",
    "semver": "^7.3.5",
    "tslib": "^2.3.0",
    "xml2js": "^0.6.2",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.6.0",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/schematics": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/semver": "^7.3.9",
    "@types/vscode": "^1.64.0",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.1.0",
    "@typescript-eslint/parser": "^8.1.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.2",
    "npm-watch": "^0.13.0",
    "ts-loader": "^9.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "webpack": "^5.69.1",
    "webpack-cli": "^5.1.4"
  },
  "jest": {
    "preset": "jest-preset-angular",
    "testPathIgnorePatterns": [
      "<rootDir>/src-ext/test/",
      "/node_modules/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/setup-jest.ts"
    ],
    "moduleNameMapper": {
      "^vscode$": "<rootDir>/__mocks__/vscode.ts",
      "^src/(.*)$": "<rootDir>/src/$1",
      "^src-common/(.*)$": "<rootDir>/src-common/$1"
    }
  }
}
